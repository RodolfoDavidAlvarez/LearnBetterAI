rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /article-images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /presentation/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
} 